# OpenRouter — provider for the default agent (Kimi K2.6 via Moonshot).
# Required for the Chainlit app and for any --model openrouter:* run.
OPENROUTER_API_KEY=

# Langfuse — tracing + observability. Always required.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Optional per-provider keys. Required ONLY for eval runs whose
# --model / --sim-model / --judge-model selects that provider.
# Example: `--model anthropic:claude-sonnet-4-5` → needs ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
